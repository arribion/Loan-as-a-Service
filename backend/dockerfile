# Step 1: Use lightweight Node base image
FROM node:22-alpine

# Step 2: Install pnpm globally inside the container
RUN npm install -g pnpm

# Step 3: Set working directory
WORKDIR /app

# Step 4: Copy package files first to leverage build cache
COPY package.json pnpm-lock.yaml ./

# Step 5: Install only production dependencies
RUN pnpm install --prod --frozen-lockfile

# Step 6: Copy necessary runtime folders and files
COPY index.js ./
COPY src/ ./src/
COPY drizzle/ ./drizzle/
COPY drizzle.config.js ./
COPY public/ ./public/
COPY views/ ./views/

# Step 7: Expose your Express port (change 3000 if your app uses a different port)
EXPOSE 3000

# Step 8: Start the application
CMD ["node", "index.js"]
